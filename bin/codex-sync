#!/usr/bin/env bash
# codex-sync
set -euo pipefail

# Read as literal release data by packaging, not used as a runtime fallback.
# shellcheck disable=SC2034
readonly VERSION=1.2.0
readonly BUILD_METADATA=''

version_text() {
	local metadata=$BUILD_METADATA script root
	if [[ -z $metadata ]]; then
		script=$(readlink -f -- "${BASH_SOURCE[0]}") || script=''
		root=${script%/bin/codex-sync}
		if [[ $root != "$script" && -e $root/.git && -f $root/scripts/build-metadata.sh ]]; then
			metadata=$(bash "$root/scripts/build-metadata.sh" 2>/dev/null) || metadata=''
		fi
	fi
	printf '%s' "${metadata:-?.?.?}"
}

diagnostic() {
	local color=$1 message=$2
	if [[ -t 2 && ! ${NO_COLOR+x} && ${color_enabled:-true} == true ]]; then
		printf '\033[%sm%s\033[0m\n' "$color" "$message" >&2
	else
		printf '%s\n' "$message" >&2
	fi
}
fail() {
	diagnostic 31 "❌ codex-sync: $*"
	exit 1
}
usage() {
	cat <<EOF
codex-sync $(version_text) — synchronize projects over SSH

Usage: codex-sync <command> [options]

Commands:
  push               Sync local project to remote (also: cpush)
  pull               Sync remote project to local (also: cpull)
  inspect            Show local exclusion rules and their sources

Options (push/pull):
  -n, --dry-run      Preview changes without applying
      --no-delete    Preserve destination-only files
  -f, --force        Overwrite newer destination files
  -c, --cleanup      Delete destination entries matching project ignore rules
  -i, --interactive  Preview and confirm before applying
  -p, --progress     Show aggregate transfer progress
      --no-progress  Disable progress
  -q, --quiet        Suppress status, preview and progress
  -v, --verbose      Show verbose rsync output

General options:
      --no-color     Disable terminal colors
  -h, --help         Show this help (use --help at top level)
      --version      Show version

By default, sync preserves newer files and deletes destination-only files.
Every sync previews changes first, then applies automatically unless -i or -n.
See README.md for setup and safety.

Examples:
  codex-sync push -n
  cpull --no-delete
  cpush -ic
  codex-sync inspect
EOF
}
assist_missing_ignore() {
	local suggested=$local_dir git_root='' answer='' physical_root
	# Git is only a hint for creation, never a synchronization-root resolver.
	if command -v git >/dev/null && git_root=$(git -C "$local_dir" rev-parse --show-toplevel 2>/dev/null); then
		if physical_root=$(cd -- "$git_root" 2>/dev/null && pwd -P); then
			case $local_dir/ in
			"${physical_root%/}/"*) suggested=$physical_root ;;
			esac
		fi
	fi
	local marker=${suggested%/}/.codexignore
	diagnostic 33 "⚠️ No .codexignore found (searched local project and parents). Suggested location: $marker"
	diagnostic 33 '⚠️ Review sensitive files and exclusions before syncing; an empty file does not protect secrets.'
	[[ -t 0 && -t 2 ]] || fail 'Noninteractive context: create and review .codexignore manually, then rerun.'
	local physical_home
	physical_home=$(cd -- "$HOME" && pwd -P) || fail 'Cannot resolve home directory'
	[[ $suggested != / && $suggested != "$physical_home" ]] || fail 'Refusing to synchronize filesystem root or home directory'
	valid_name "${suggested##*/}" || fail "Invalid project name: ${suggested##*/}"
	printf '⚠️ Create empty .codexignore at %s? [y/N] ' "$marker" >&2
	if ! IFS= read -r answer; then answer=''; fi
	case $answer in
	y | Y | yes | YES | Yes)
		# Atomic exclusive creation: refuse existing files, directories and symlinks.
		if ! (
			set -o noclobber
			: >"$marker"
		) 2>/dev/null; then
			fail "Cannot create .codexignore without overwriting an existing entry: $marker"
		fi
		diagnostic 33 "⚠️ Created empty $marker. Review sensitive files and exclusions, then rerun. No synchronization performed."
		;;
	*) diagnostic 33 '⚠️ Creation declined. Create and review .codexignore, then rerun. No synchronization performed.' ;;
	esac
	exit 1
}
no_global_directive() {
	local line=${1%$'\r'}
	line="${line#"${line%%[!$' \t']*}"}"
	line="${line%"${line##*[!$' \t']}"}"
	[[ $line == '# codex-sync: no-global-ignore' ]]
}
project_patterns() {
	local pattern
	while IFS= read -r pattern || [[ -n $pattern ]]; do
		if [[ $1 != "$project_ignore" ]] || ! no_global_directive "$pattern"; then printf '%s\n' "$pattern"; fi
	done <"$1"
}
display_path() {
	local home=${HOME%/}
	if [[ $1 == "$HOME" || $1 == "$home" ]]; then
		printf '~'
	elif [[ $1 == "$home/"* ]]; then
		printf '%s/%s' '~' "${1#"$home/"}"
	else
		printf '%s' "$1"
	fi
}
display_sorted_patterns() {
	# Sort only report rows, using a deterministic bytewise A-Z order.
	local LC_ALL=C pattern i
	local -a rows=()
	while IFS= read -r pattern; do
		i=${#rows[@]}
		while ((i > 0)) && [[ ${rows[i - 1]} > $pattern ]]; do
			rows[i]=${rows[i - 1]}
			i=$((i - 1))
		done
		rows[i]=$pattern
	done
	for pattern in "${rows[@]}"; do printf '  %s\n' "$pattern"; done
}
display_patterns() {
	local pattern
	while IFS= read -r pattern; do
		# rsync exclude-from files ignore empty lines and leading # or ; comments.
		case $pattern in
		'' | $'\r' | \#* | \;*) continue ;;
		esac
		printf '%s\n' "$pattern"
	done < <(project_patterns "$1") | display_sorted_patterns
}
valid_name() { [[ $1 =~ ^[a-zA-Z0-9_-]([a-zA-Z0-9_.-]*[a-zA-Z0-9_-])?$ ]]; }
optional_file() {
	if [[ -e $1 || -L $1 ]]; then
		[[ -f $1 && -r $1 ]] || fail "Not a readable file: $1"
	fi
}

[[ $# -gt 0 ]] || {
	usage >&2
	exit 2
}
case $1 in
--help)
	usage
	exit 0
	;;
--version)
	printf 'codex-sync %s\n' "$(version_text)"
	exit 0
	;;
push | pull | inspect)
	command=$1
	shift
	;;
*) fail "Expected push, pull or inspect (see --help)" ;;
esac
dry_run=false delete=true force=false cleanup=false interactive=false
quiet=false verbose=false color_enabled=true
progress=auto
# Expand composable short flags without changing left-to-right option handling.
expanded=()
for arg in "$@"; do
	if [[ $arg == -?* && $arg != --* ]]; then
		for ((j = 1; j < ${#arg}; j++)); do expanded+=("-${arg:j:1}"); done
	else expanded+=("$arg"); fi
done
for arg in "${expanded[@]}"; do
	case $arg in
	--help | -h)
		usage
		exit 0
		;;
	--version)
		printf 'codex-sync %s\n' "$(version_text)"
		exit 0
		;;
	--no-color) color_enabled=false ;;
	*)
		[[ $command != inspect ]] || fail "Unsupported option for inspect: $arg"
		case $arg in
		--dry-run | -n) dry_run=true ;;
		--no-delete) delete=false ;;
		--force | -f) force=true ;;
		--cleanup | -c) cleanup=true ;;
		--interactive | -i) interactive=true ;;
		--progress | -p) progress=yes ;;
		--no-progress) progress=no ;;
		--quiet | -q)
			quiet=true
			verbose=false
			;;
		--verbose | -v)
			verbose=true
			quiet=false
			;;
		--*) fail "Unknown option: $arg" ;;
		*) fail "Unexpected argument: $arg (run from the project directory)" ;;
		esac
		;;
	esac
done
if $cleanup && ! $delete; then fail '--cleanup requires deletion; cannot combine with --no-delete'; fi
config=${XDG_CONFIG_HOME:-$HOME/.config}/codex-sync
local_dir=$(pwd -P) || fail 'Cannot resolve local project'
# Walk physical local parents only; an invalid nearest entry must not be skipped.
ignore_dir=$local_dir
project_ignore=''
while :; do
	candidate=${ignore_dir%/}/.codexignore
	if [[ -e $candidate || -L $candidate ]]; then
		project_ignore=$candidate
		break
	fi
	[[ $ignore_dir != / ]] || break
	ignore_dir=${ignore_dir%/*}
	[[ -n $ignore_dir ]] || ignore_dir=/
done
if [[ -z $project_ignore && $command != inspect ]]; then assist_missing_ignore; fi
[[ -n $project_ignore && -f $project_ignore && -r $project_ignore ]] || fail "Required local project ignore file is missing or not a readable regular file: ${project_ignore:-$local_dir/.codexignore} (searched local project and parents; create it; an empty file is valid)"
local_dir=$ignore_dir
project=${local_dir##*/}
home_dir=$(cd -- "$HOME" && pwd -P) || fail 'Cannot resolve home directory'
[[ $local_dir != / && $local_dir != "$home_dir" ]] || fail 'Refusing to synchronize filesystem root or home directory'
valid_name "$project" || fail "Invalid project name: $project"
excludes=()
builtin_patterns=('.git/' '.ssh/' '.codexignore')
for pattern in "${builtin_patterns[@]}"; do
	excludes+=("--exclude=$pattern")
done
no_global=false
while IFS= read -r pattern || [[ -n $pattern ]]; do
	if no_global_directive "$pattern"; then no_global=true; fi
done <"$project_ignore"
ignore_files=("$project_ignore")
if ! $no_global; then ignore_files=("$config/ignore" "${ignore_files[@]}"); fi
for ignore in "${ignore_files[@]}"; do
	optional_file "$ignore"
	if [[ -f $ignore ]]; then
		# rsync's list-clearing token would remove the mandatory exclusions.
		while IFS= read -r pattern || [[ -n $pattern ]]; do
			[[ $pattern != '!' && $pattern != $'!\r' ]] || fail "Ignore file cannot clear mandatory exclusions: $ignore"
		done <"$ignore"
		if $no_global; then
			excludes+=(--exclude-from=-)
		else
			excludes+=("--exclude-from=$ignore")
		fi
	fi
done
# Validation and source selection above are shared with both transfer directions.
if [[ $command == inspect ]]; then
	bold='' reset='' red=''
	if [[ -t 1 && ! ${NO_COLOR+x} && ${color_enabled:-true} == true ]]; then
		bold=$'\033[1m' reset=$'\033[0m' red=$'\033[31m'
	fi
	printf '%sSync root:%s %s\n%sBuilt-in:%s\n' "$bold" "$reset" "$(display_path "$local_dir")" "$bold" "$reset"
	printf '%s\n' "${builtin_patterns[@]}" | display_sorted_patterns
	printf '%sGlobal:%s %s' "$bold" "$reset" "$(display_path "$config/ignore")"
	if $no_global; then
		printf ' %s[disabled]%s' "$red" "$reset"
	fi
	printf '\n'
	if ! $no_global && [[ -f $config/ignore ]]; then display_patterns "$config/ignore"; fi
	printf '%sLocal:%s %s\n' "$bold" "$reset" "$(display_path "$project_ignore")"
	display_patterns "$project_ignore"
	exit 0
fi
# Cleanup uses rsync's receiver deletion engine, never shell path deletion.
# Protect built-ins and global rules even when project exclusions are deleted.
if $cleanup; then
	cleanup_filters=()
	for pattern in "${builtin_patterns[@]}"; do cleanup_filters+=("--filter=P $pattern"); done
	if ! $no_global && [[ -f $config/ignore ]]; then
		while IFS= read -r pattern || [[ -n $pattern ]]; do
			pattern=${pattern%$'\r'}
			case $pattern in '' | $'\r' | \#* | \;*) continue ;; esac
			case $pattern in '+ '* | '- '* | *../*) fail 'Cleanup requires plain exclusion patterns without parent traversal in active ignore files' ;; esac
			cleanup_filters+=("--filter=P $pattern")
		done <"$config/ignore"
	fi
	while IFS= read -r pattern || [[ -n $pattern ]]; do
		pattern=${pattern%$'\r'}
		case $pattern in '' | $'\r' | \#* | \;*) continue ;; esac
		case $pattern in '+ '* | '- '* | *../*) fail 'Cleanup requires plain exclusion patterns without parent traversal in active ignore files' ;; esac
	done < <(project_patterns "$project_ignore")
	excludes=("${cleanup_filters[@]}" "${excludes[@]}")
fi
if $interactive && ! $dry_run; then
	[[ -t 0 && -t 2 ]] || fail 'Interactive sync requires terminal stdin and stderr; no synchronization performed'
fi
host=codex
optional_file "$config/target-host"
if [[ -f $config/target-host ]]; then host=$(cat -- "$config/target-host"); fi
[[ $host =~ ^([a-zA-Z0-9_][a-zA-Z0-9_.-]*@)?[a-zA-Z0-9_][a-zA-Z0-9_.-]*$ ]] || fail 'Invalid target-host: expected one SSH host name or alias'
command -v ssh >/dev/null || fail 'OpenSSH client (ssh) is required'
command -v rsync >/dev/null || fail 'rsync is required'
# Only the validated project name expands locally; remote variables stay escaped.
# Exit 3 means an absent entry; files, dangling symlinks and unsafe aliases fail.
remote_check="p=\"\$HOME/$project\"; if test ! -e \"\$p\" && test ! -L \"\$p\"; then exit 3; fi; test -d \"\$p\" && r=\$(cd -- \"\$p\" && pwd -P) && h=\$(cd -- \"\$HOME\" && pwd -P) && test \"\$r\" != / && test \"\$r\" != \"\$h\""
remote_status=0
# shellcheck disable=SC2029
ssh "$host" "$remote_check" || remote_status=$?
if ((remote_status != 0)); then
	if ((remote_status != 3)); then
		fail "Remote project unsafe, inaccessible, or SSH check failed: $host:~/$project"
	fi
	[[ $command == push ]] || fail "Remote project missing: $host:~/$project (pull never creates directories)"
	! $dry_run || fail "Remote destination missing: $host:~/$project (dry-run never creates directories)"
	[[ -t 0 && -t 2 ]] || fail "Remote destination missing: $host:~/$project (noninteractive context; create it manually)"
	printf '⚠️ Create remote destination directory %s:~/%s? [y/N] ' "$host" "$project" >&2
	answer=''
	if ! IFS= read -r answer; then answer=''; fi
	case $answer in
	y | Y | yes | YES | Yes) ;;
	*) fail 'Remote directory creation declined. No synchronization performed.' ;;
	esac
	# No -p: fail if any entry appeared after validation; never overwrite it.
	# shellcheck disable=SC2029
	ssh "$host" "mkdir -- \"\$HOME/$project\"" || fail "Cannot create remote destination: $host:~/$project"
	# Recheck directory safety after successful creation before any transfer.
	# shellcheck disable=SC2029
	ssh "$host" "$remote_check" || fail "Created remote destination failed validation: $host:~/$project"
fi
local_path=$local_dir/
remote_path="$host:~/$project/"
if [[ $command == push ]]; then
	source=$local_path
	destination=$remote_path
else
	source=$remote_path
	destination=$local_path
fi
run_rsync() {
	if $no_global; then
		project_patterns "$project_ignore" | rsync "$@" "${excludes[@]}" -- "$source" "$destination"
	else
		rsync "$@" "${excludes[@]}" -- "$source" "$destination"
	fi
}
options=(-a)
if $delete; then options+=(--delete); fi
if $cleanup; then options+=(--delete-excluded); fi
if ! $force; then
	# Count only regular-file transfer records; no filenames or human skip text
	# are parsed. Identical read-only probes differ solely by --update.
	before=$(run_rsync -a --dry-run --out-format='%i') || fail 'Newer-file comparison failed'
	after=$(run_rsync -a --dry-run --update --out-format='%i') || fail 'Newer-file comparison failed'
	before_count=0 after_count=0
	while IFS= read -r record; do
		if [[ $record == [\<\>]f????????? ]]; then before_count=$((before_count + 1)); fi
	done <<<"$before"
	while IFS= read -r record; do
		if [[ $record == [\<\>]f????????? ]]; then after_count=$((after_count + 1)); fi
	done <<<"$after"
	skipped=$((before_count - after_count))
	if ((skipped > 0)); then diagnostic 33 "⚠️ $skipped newer destination file(s) skipped in comparison; use --force to overwrite. Files may change after this check."; fi
	options+=(--update)
fi
if $verbose; then options+=(-v); fi
if $quiet; then options+=(--quiet); fi
if ! $quiet && { [[ $progress == yes ]] || { [[ $progress == auto && -t 1 ]] && ! $verbose; }; }; then
	options+=(--info=progress2)
fi
if ! $quiet; then printf 'ℹ️ %s: %s -> %s\n' "$command" "$source" "$destination"; fi
# Keep preview options independent of transfer verbosity and progress. Rsync's
# default escaped %n representation makes every name one printable record,
# including embedded newlines and literal backslash-octal-looking names. Never
# decode it or split paths on whitespace; %i has a fixed eleven-byte width.
preview_options=(-a)
if $delete; then preview_options+=(--delete); fi
if $cleanup; then preview_options+=(--delete-excluded); fi
if ! $force; then preview_options+=(--update); fi
preview=$(LC_ALL=C run_rsync "${preview_options[@]}" --dry-run --itemize-changes '--out-format=%i|%n') || fail 'Preview failed; no synchronization performed'
if ! $quiet || $interactive; then
	added=0 modified=0 deleted=0
	green='' red='' yellow='' reset=''
	if [[ -t 1 && ! ${NO_COLOR+x} && $color_enabled == true ]]; then
		green=$'\033[32m' red=$'\033[31m' yellow=$'\033[33m' reset=$'\033[0m'
	fi
	while IFS= read -r record; do
		[[ -n $record ]] || continue
		if [[ ${#record} -lt 12 || ${record:11:1} != '|' ]]; then
			# Rsync can report protected, nonempty cleanup directories on stdout.
			printf '%s\n' "$record" >&2
			continue
		fi
		item=${record:0:11}
		path=${record:12}
		if $verbose; then printf '%s\n' "$record"; fi
		if [[ $item == '*deleting  ' ]]; then
			sign=-
			color=$red
			deleted=$((deleted + 1))
		elif [[ ${item:2} == '+++++++++' ]]; then
			sign=+
			color=$green
			added=$((added + 1))
		elif [[ ${item:1:1} == d ]]; then
			# Existing-directory timestamps/permissions are archive metadata noise.
			continue
		else
			sign='~'
			color=$yellow
			modified=$((modified + 1))
		fi
		if ! $verbose; then printf '%s%s%s %s\n' "$color" "$sign" "$reset" "$path"; fi
	done <<<"$preview"
	printf 'Preview: %d added, %d modified, %d deleted\n' "$added" "$modified" "$deleted"
fi
if $dry_run; then exit 0; fi
if $interactive; then
	[[ -t 0 && -t 2 ]] || fail 'Interactive sync requires terminal stdin and stderr; no synchronization performed'
	printf '⚠️ Apply this preview%s? [y/N] ' "$(if $cleanup; then printf ' including ignored destination cleanup'; fi)" >&2
	answer=''
	if ! IFS= read -r answer; then answer=''; fi
	case $answer in y | Y | yes | YES | Yes) ;; *) fail 'Synchronization declined' ;; esac
fi
if $delete; then diagnostic 33 '⚠️ Sync will delete destination-only files.'; fi
if $cleanup; then diagnostic 33 '⚠️ Cleanup also deletes destination entries matching project ignore rules (built-in and global protections remain).'; fi
run_rsync "${options[@]}"
